# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_, and it
# inlines them into the bundle at BUILD time — so everything here is PUBLIC once
# deployed, and setting a value after a build has no effect. Never put a private
# key in this file.

# --- Particle Network (dashboard.particle.network) ---------------------------
# Without all three the app runs entirely on demo data.
VITE_PARTICLE_PROJECT_ID=
VITE_PARTICLE_CLIENT_KEY=
VITE_PARTICLE_APP_ID=

# Set to "false" to force the mock layer even when credentials are present.
VITE_PARTICLE_ENABLED=true

# --- Gasless (dashboard.pimlico.io) ------------------------------------------
# Sponsors gas for user operations. Without it, sign-in and the Safe address
# still work; only sponsored sending is disabled.
# This key ships inside the bundle and is therefore PUBLIC — restrict it with a
# Sponsorship Policy in the Pimlico dashboard before deploying, or anyone
# reading the bundle can spend it.
VITE_PIMLICO_API_KEY=

# --- Backend (oracle-gateway) ------------------------------------------------
# Escrow reads, evidence, faucet, and dispute PREPARATION. The gateway never
# signs for the user: raiseDispute is built from its calldata and submitted by
# the Particle Smart Account (docs/FRONTEND_HANDOFF_UPDATED.md §9).
# No trailing slash — a trailing / produces //escrows, which Express 404s.
VITE_ORACLE_API=http://localhost:4000

# --- Chain -------------------------------------------------------------------
VITE_CHAIN_ID=80002
# The RPC the browser calls directly (deriving the Safe address is a real
# eth_call), so it MUST allow browser requests. An RPC without CORS headers
# fails with a bare "Failed to fetch"; rpc-amoy.polygon.technology is known to
# refuse. Leave blank for the built-in default, or try, in order:
#   https://polygon-amoy-bor-rpc.publicnode.com
#   https://polygon-amoy.drpc.org
#   https://polygon-amoy.g.alchemy.com/v2/<your-key>   (most reliable)
VITE_RPC_URL=

# --- Contracts (fill in after the Fase 0 deploy) -----------------------------
# Both are required for on-chain mode, AND the Particle keys above must be set:
# with contracts but no wallet the app would show a generated demo address and
# invite you to mint real tokens to it.
VITE_CONTRACT_ADDRESS=
VITE_IDRT_TOKEN_ADDRESS=
