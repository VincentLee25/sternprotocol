# Root .env — contracts (Hardhat) and the oracle gateway.
#
# Everything here is a SECRET. None of it may be copied into frontend/.env:
# anything with a VITE_ prefix is inlined into the browser bundle and readable by
# anyone. A private key or INTERNAL_API_KEY that reaches the bundle is a key that
# has been published.
#
# Deploying? See docs/TRIAL_DEMO_AND_DEPLOY.md (first time) or
# docs/DEPLOY_ULANG.md (redeploying something already live).

# --- Chain -------------------------------------------------------------------
# RPC_URL is what the gateway calls. AMOY_RPC_URL is what Hardhat deploys through.
RPC_URL=http://127.0.0.1:8545
AMOY_RPC_URL=

# Filled in after `npx hardhat run scripts/deploy.js` — the SternEscrow address.
CONTRACT_ADDRESS=

# --- Wallets -----------------------------------------------------------------
# Deploys the contracts and pays deploy gas.
DEPLOYER_PRIVATE_KEY=

# EXACTLY three keys, comma-separated, all different. Order assigns the roles:
#   1st -> ROLE_QUALITY_AUDITOR  (milestone 1, inspection)
#   2nd -> ROLE_LOGISTICS        (milestone 2, shipping)
#   3rd -> ROLE_CUSTOMS          (milestone 3, customs)
# Read in two places — hardhat.config.js at deploy time, and the gateway at run
# time. One value, both places; keep them in sync if you rotate keys.
ORACLE_PRIVATE_KEYS=

# Legacy single-key fallback (1-of-1). Only for local experiments.
ORACLE_PRIVATE_KEY=

# Resolves disputes. Needs gas of its own.
ARBITER_PRIVATE_KEY=

# Mints IDRT-demo for the faucet. Must hold MINTER_ROLE on IDRTDemo — the
# deployer does, so reusing DEPLOYER_PRIVATE_KEY here is the simple choice.
IDRT_MINTER_PRIVATE_KEY=

# --- Gateway -----------------------------------------------------------------
PORT=4000

# Guards the three write routes whose caller picks the milestone and the proof
# CID: /submit-oracle, /milestones/:id/submit, /resolve-dispute. In a browser
# bundle this key lets anyone forge a milestone proof from DevTools.
INTERNAL_API_KEY=

# Signs company session tokens. At least 32 random characters, and never reuse
# an example value from documentation.
AUTH_TOKEN_SECRET=

# Exact frontend origin(s), comma-separated. Leaving this at * is fine locally
# and wrong in production. A mismatch shows up in the browser as "Could not
# reach the STERN gateway" while /health answers normally over curl.
CORS_ORIGINS=*

# On a host with ephemeral disk (most free tiers), point these at a persistent
# volume — otherwise every redeploy wipes registered company accounts and the
# faucet claim history. On Railway: attach a volume at /data and use
# /data/identities.json and /data/demo-claims.json.
IDENTITY_STORE_FILE=
DEMO_CLAIMS_FILE=

# One-time faucet grant per wallet.
DEMO_BALANCE_IDRT=150000000.00

# --- e-BL on IPFS ------------------------------------------------------------
# The bill of lading is pinned to IPFS, and the CID that goes on chain is the
# address it actually resolves at. Set ONE of the two below.
#
# Without either, the gateway keeps running and the e-BL check reports itself
# as unavailable rather than passing — and the app falls back to a local
# content hash that resolves nowhere. Check which mode you are in:
#   curl $GATEWAY/ipfs/status
#
# Hosted: a JWT from pinata.cloud (Files API keys → New Key → pinFileToIPFS).
# It can pin, unpin and bill, so it is a secret: gateway only, never VITE_.
PINATA_JWT=

# Self-hosted alternative: the RPC address of your own Kubo node, e.g.
# http://127.0.0.1:5001. IPFS_API_AUTH is an optional Authorization header if
# that node sits behind a proxy. Leave both blank when using Pinata.
IPFS_API_URL=
IPFS_API_AUTH=

# Read paths, tried in order. Public gateways need no key. More than one means
# a single slow gateway does not fail the check.
IPFS_GATEWAYS=https://gateway.pinata.cloud,https://ipfs.io,https://dweb.link

# Below this native balance the gateway warns that a verifier is about to run
# out of gas. Default 0.001 POL.
NATIVE_GAS_WARNING_WEI=

# --- scripts/deploy.js overrides ---------------------------------------------
# Defaults: 6h challenge window, 24h timelock, 3% dispute bond, 50% slash.
CHALLENGE_WINDOW_SECONDS=
TIMELOCK_DURATION_SECONDS=
DISPUTE_BOND_BPS=
SLASH_BPS=
