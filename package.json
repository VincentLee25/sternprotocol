{
  "name": "stern-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "STERN Protocol smart escrow MVP for export-import settlement.",
  "scripts": {
    "start": "node backend/oracle-gateway/index.js",
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:identity": "node --test backend/oracle-gateway/identityService.test.js",
    "check:identity-db": "node backend/oracle-gateway/db/checkConnection.js",
    "migrate:identity": "node backend/oracle-gateway/db/migrate.js",
    "import:identities": "node backend/oracle-gateway/db/importLegacyIdentities.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "mine:128": "hardhat run scripts/mine-blocks.js --network localhost",
    "post-bond": "node scripts/post-bond.js",
    "backend": "node scripts/post-bond.js && node backend/oracle-gateway/index.js",
    "make-demo-ebl": "node scripts/make-demo-ebl.js",
    "test:ebl": "node scripts/test-ebl-ipfs.js",
    "pin-demo-ebl": "node scripts/pin-demo-ebl.js",
    "test:ebl-gate": "node scripts/test-ebl-gate.js",
    "dispute-status": "node scripts/dispute-status.js",
    "test:ebl-coherence": "node scripts/test-ebl-coherence.mjs",
    "test:dispute-rehearsal": "node scripts/test-dispute-rehearsal.mjs",
    "test:all": "node scripts/test-ebl-ipfs.js && node scripts/test-ebl-gate.js && node scripts/test-ebl-coherence.mjs && node scripts/test-dispute-rehearsal.mjs && node scripts/test-evidence-subject.mjs && node scripts/test-directory.js && node scripts/test-manifest.js && node scripts/test-activity-scan.js && node scripts/test-clauses.js && node scripts/test-negotiation.js && node --test backend/oracle-gateway/identityService.test.js",
    "test:evidence-subject": "node scripts/test-evidence-subject.mjs",
    "test:directory": "node scripts/test-directory.js",
    "test:manifest": "node scripts/test-manifest.js",
    "test:activity": "node scripts/test-activity-scan.js",
    "test:clauses": "node scripts/test-clauses.js",
    "test:negotiation": "node scripts/test-negotiation.js",
    "make-demo-docs": "node scripts/make-demo-docs.js",
    "documents-stub": "node scripts/test-support/documents-gateway-stub.js",
    "directory-stub": "node scripts/test-support/directory-gateway-stub.js",
    "chain-lag": "node scripts/chain-lag.js",
    "reset-faucet-claim": "node scripts/reset-faucet-claim.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "ipfs-only-hash": "^4.0.0",
    "pdf-parse": "^2.4.5",
    "permissionless": "0.4.0",
    "pg": "8.23.0",
    "viem": "2.44.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "hardhat": "^2.26.0"
  }
}
